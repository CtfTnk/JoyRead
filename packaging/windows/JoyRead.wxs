<?xml version="1.0" encoding="utf-8"?>
<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="JoyRead"
    Manufacturer="JoyRead contributors"
    Version="$(Version)"
    UpgradeCode="2FC32BD6-FE41-52BC-AFD4-37F3789A965D"
    Scope="perMachine"
    InstallerVersion="500"
    Language="1033">

    <!-- A conventional machine-wide desktop install: Program Files, common
         Start menu/Desktop locations, HKLM registration and normal UAC. -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="JoyRead" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- Medium compression trades a modestly larger download for less work
         during install. The full UI below exposes real progress and finish. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="medium" />
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <Icon Id="JoyRead.exe" SourceFile="!(bindpath.AppDir)\JoyRead.exe" />
    <Property Id="ARPPRODUCTICON" Value="JoyRead.exe" />

    <!-- FeatureTree always shows customization. The root feature owns the
         configurable install directory; its two children are real options. -->
    <Feature
      Id="CoreApplication"
      Title="JoyRead application"
      Description="Required application files and Start menu shortcut."
      Level="1"
      AllowAbsent="no"
      AllowAdvertise="no"
      Display="expand"
      ConfigurableDirectory="INSTALLFOLDER">

      <Component Id="ApplicationExecutable" Directory="INSTALLFOLDER" Bitness="always64">
        <File
          Id="JoyReadExe"
          Source="!(bindpath.AppDir)\JoyRead.exe"
          KeyPath="yes">
          <Shortcut
            Id="JoyReadStartMenuShortcut"
            Directory="ProgramMenuFolder"
            Name="JoyRead"
            Description="Local manga and document reader"
            WorkingDirectory="INSTALLFOLDER"
            Icon="JoyRead.exe"
            IconIndex="0"
            Advertise="yes" />
        </File>
      </Component>

      <!-- Harvest the rest of PyInstaller's onedir tree without duplicating EXE. -->
      <Files Include="!(bindpath.AppDir)\**" Directory="INSTALLFOLDER">
        <Exclude Files="!(bindpath.AppDir)\JoyRead.exe" />
      </Files>

      <Feature
        Id="DesktopShortcutFeature"
        Title="Desktop shortcut"
        Description="Create a JoyRead shortcut on the desktop."
        Level="1"
        AllowAbsent="yes"
        AllowAdvertise="no"
        TypicalDefault="install">
        <Component Id="DesktopShortcut" Directory="INSTALLFOLDER" Bitness="always64">
          <Shortcut
            Id="JoyReadDesktopShortcut"
            Directory="DesktopFolder"
            Name="JoyRead"
            Description="Local manga and document reader"
            Target="[INSTALLFOLDER]JoyRead.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="JoyRead.exe"
            IconIndex="0" />
          <RegistryValue
            Root="HKCU"
            Key="Software\JoyRead"
            Name="DesktopShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Feature>

      <!-- Default-off. Selecting this feature registers candidates for Open
           With/Default Apps; it does not set the protected per-user default. -->
      <Feature
        Id="FileAssociationsFeature"
        Title="Open With integration"
        Description="Offer JoyRead for CBZ, CBR, CB7 and PDF files. Windows still lets each user choose the default app."
        Level="2"
        AllowAbsent="yes"
        AllowAdvertise="no">
        <Component Id="FileAssociations" Directory="INSTALLFOLDER" Bitness="always64">
          <RegistryKey Root="HKLM" Key="Software\Classes\JoyRead.Document">
            <RegistryValue Type="string" Value="JoyRead Document" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="Software\Classes\JoyRead.Document\DefaultIcon">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]JoyRead.exe,0" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="Software\Classes\JoyRead.Document\shell\open\command">
            <RegistryValue
              Type="string"
              Value="&quot;[INSTALLFOLDER]JoyRead.exe&quot; &quot;%1&quot;" />
          </RegistryKey>

          <RegistryKey Root="HKLM" Key="Software\Classes\.cbz\OpenWithProgids">
            <RegistryValue Name="JoyRead.Document" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="Software\Classes\.cbr\OpenWithProgids">
            <RegistryValue Name="JoyRead.Document" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="Software\Classes\.cb7\OpenWithProgids">
            <RegistryValue Name="JoyRead.Document" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="Software\Classes\.pdf\OpenWithProgids">
            <RegistryValue Name="JoyRead.Document" Type="string" Value="" />
          </RegistryKey>

          <RegistryKey Root="HKLM" Key="Software\Classes\Applications\JoyRead.exe">
            <RegistryValue Name="FriendlyAppName" Type="string" Value="JoyRead" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="Software\Classes\Applications\JoyRead.exe\shell\open\command">
            <RegistryValue
              Type="string"
              Value="&quot;[INSTALLFOLDER]JoyRead.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="Software\Classes\Applications\JoyRead.exe\SupportedTypes">
            <RegistryValue Name=".cbz" Type="string" Value="" />
            <RegistryValue Name=".cbr" Type="string" Value="" />
            <RegistryValue Name=".cb7" Type="string" Value="" />
            <RegistryValue Name=".pdf" Type="string" Value="" />
          </RegistryKey>

          <RegistryKey Root="HKLM" Key="Software\JoyRead\Capabilities">
            <RegistryValue Name="ApplicationName" Type="string" Value="JoyRead" />
            <RegistryValue
              Name="ApplicationDescription"
              Type="string"
              Value="Read local manga archives and PDF documents." />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="Software\JoyRead\Capabilities\FileAssociations">
            <RegistryValue Name=".cbz" Type="string" Value="JoyRead.Document" />
            <RegistryValue Name=".cbr" Type="string" Value="JoyRead.Document" />
            <RegistryValue Name=".cb7" Type="string" Value="JoyRead.Document" />
            <RegistryValue Name=".pdf" Type="string" Value="JoyRead.Document" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="Software\RegisteredApplications">
            <RegistryValue
              Name="JoyRead"
              Type="string"
              Value="Software\JoyRead\Capabilities"
              KeyPath="yes" />
          </RegistryKey>
          <RegistryKey
            Root="HKLM"
            Key="Software\Microsoft\Windows\CurrentVersion\App Paths\JoyRead.exe">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]JoyRead.exe" />
            <RegistryValue Name="Path" Type="string" Value="[INSTALLFOLDER]" />
          </RegistryKey>
        </Component>
      </Feature>
    </Feature>

    <ui:WixUI
      Id="WixUI_FeatureTree"
      InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />
  </Package>
</Wix>
