/* Base typography */
QWidget {
    font-family: __FONT_FAMILY__;
    color: #000000;
}

/* Conditional title overflow hints */
QToolTip {
    color: __TEXT_COLOR__;
    background: __WINDOW_COLOR__;
    border: 1px solid __BUTTON_INNER_EDGE__;
    border-radius: __TOOLTIP_RADIUS__;
    padding: __TOOLTIP_PADDING__;
}

/* Figma control dimensions are fixed in Python via Theme constants.
   Do not add QSS min/max sizes to those controls: Qt treats them as
   content-box values and then adds border/padding, which changes the
   external size. */

/* Window shell */
QMainWindow#MainWindow {
    background: transparent;
}

QWidget#RootPanel {
    background: #ffffff;
    border-radius: __WINDOW_RADIUS__;
}

QWidget#ViewPanel {
    background: #ffffff;
    /* add radius to the bottom corners to match the root panel */
    border-bottom-left-radius: __WINDOW_RADIUS__;
    border-bottom-right-radius: __WINDOW_RADIUS__;
}

QWidget#WindowChrome {
    background: #ffffff;
    border-top-left-radius: __WINDOW_RADIUS__;
    border-top-right-radius: __WINDOW_RADIUS__;
}

/* Frameless chrome controls */
QToolButton#CloseButton,
QToolButton#MinimizeButton,
QToolButton#ZoomButton {
    border-radius: 7px;
}

QToolButton#CloseButton {
    background-color: #ff736a;
    border: 1px solid #e6685f;
}

QToolButton#MinimizeButton {
    background-color: #febc2e;
    border: 1px solid #e5a929;
}

QToolButton#ZoomButton {
    background-color: #19c332;
    border: 1px solid #16b02d;
}

QToolButton#CloseButton:hover {
    border: 1px solid #b3504a;
}

QToolButton#MinimizeButton:hover {
    border: 1px solid #b28520;
}

QToolButton#ZoomButton:hover {
    border: 1px solid #128924;
}

QToolButton[class="ChromeButton"] {
    background: #ffffff;
    border: 1px solid #929292;
    border-radius: 10px;
    padding: 4px;
}

QToolButton[class="ChromeButton"]:hover {
    background: #e5e5e5;
}

QToolButton[class="ChromeButton"]:checked {
    background: #e5e5e5;
}

QToolButton[class="ChromeButton"]:disabled {
    background: #929292;
    border: 1px solid #e0e0e0;
}

QToolButton[class="ChromeButton"]::menu-indicator {
    image: none;
    width: 0;
}

/* Reader window */
QMainWindow#ReaderWindow {
    background: transparent;
}

QWidget#ReaderRootPanel {
    background: transparent;
    border-radius: __READER_RADIUS__;
}

QWidget#ReaderCanvas {
    background: transparent;
    border-radius: __READER_RADIUS__;
}

QWidget#ReaderHeader {
    background: transparent;
    border-top-left-radius: __READER_RADIUS__;
    border-top-right-radius: __READER_RADIUS__;
}

QWidget#ReaderFooter {
    background: transparent;
    border: none;
}

QToolButton[class="ReaderButton"] {
    background: __READER_CONTROL_NORMAL__;
    border: none;
    border-radius: __READER_CONTROL_RADIUS__;
    padding: 4px;
}

QToolButton[class="ReaderButton"]:hover,
QToolButton[class="ReaderButton"]:checked {
    background: __READER_CONTROL_SELECTED__;
}

QToolButton[class="ReaderButton"]:disabled {
    background: rgba(146, 146, 146, 0.35);
}

QFrame[class="ReaderTopGroup"] {
    background: __WINDOW_COLOR__;
    border: 2px solid __BUTTON_EDGE__;
    border-radius: __READER_CONTROL_RADIUS__;
}

QFrame[class="ReaderSwitch"] {
    background: __READER_SWITCH_PANEL__;
    border: none;
    border-radius: __READER_CONTROL_RADIUS__;
}

QToolButton[class="ReaderSwitchOption"] {
    background: transparent;
    border: none;
    border-radius: __READER_SWITCH_OPTION_RADIUS__;
    padding: 0;
}

QToolButton[class="ReaderSwitchOption"]:hover,
QToolButton[class="ReaderSwitchOption"]:checked {
    background: __READER_CONTROL_SELECTED__;
}

QToolButton[class="ReaderSideButton"] {
    background: __READER_PANEL__;
    border: none;
    border-radius: __READER_SIDE_BUTTON_RADIUS__;
    padding: 0;
}

QToolButton[class="ReaderSideButton"]:hover {
    background: rgba(146, 146, 146, 0.55);
}

QLabel#ReaderTitle {
    color: __TEXT_COLOR__;
    font-size: __BODY_FONT_SIZE__;
    font-weight: 400;
}

QLabel#ReaderStatusText {
    color: __TEXT_MUTED_COLOR__;
    font-size: __BODY_FONT_SIZE__;
    font-weight: 500;
}

QFrame#ReaderSettingsPanel {
    background: __MENU_BACKGROUND__;
    border: __READER_SETTINGS_PANEL_BORDER_WIDTH__ solid __BUTTON_EDGE__;
    border-radius: __READER_SETTINGS_PANEL_RADIUS__;
}

QLabel[class="ReaderSettingsLabel"] {
    color: __TEXT_COLOR__;
    font-size: __SETTINGS_ITEM_FONT_SIZE__;
    font-weight: 500;
}

QComboBox#ReaderFitModeCombo {
    background: __WINDOW_COLOR__;
    border: 1px solid __BUTTON_INNER_EDGE__;
    border-radius: __SETTINGS_ITEM_RADIUS__;
    color: __TEXT_COLOR__;
    font-size: __SETTINGS_CONTROL_FONT_SIZE__;
    padding: 2px 6px;
}

QFrame[class="ActionMenuButton"] {
    background: #ffffff;
    border: 1px solid #929292;
    border-radius: 10px;
}

QFrame[class="ActionMenuButton"]:hover {
    background: #e5e5e5;
}

/* Figma switch shell; option cells are custom-painted in Python. */
QFrame[class="FigmaSwitch"] {
    background: #bfbfbf;
    border: 2px solid #929292;
    border-radius: 10px;
}

QToolButton[class="FigmaSwitchOption"] {
    background: transparent;
    border: none;
    padding: 0;
}

QSizeGrip#ResizeGrip {
    background: transparent;
}

/* Sidebar */
QWidget#Sidebar {
    background: __WINDOW_COLOR__;
}

QWidget#SidebarUpperPart,
QWidget#SidebarLowerPart,
QWidget#SidebarSectionGroup,
QWidget#SidebarCollectionsContainer {
    background: transparent;
}

QScrollArea#SidebarScrollArea,
QWidget#SidebarScrollViewport {
    background: transparent;
    border: none;
}

QFrame#SidebarSectionBanner {
    background: transparent;
    border: none;
}

QLabel#SidebarSectionLabel {
    color: __SIDEBAR_SECTION_COLOR__;
    font-size: __SIDEBAR_SECTION_FONT_SIZE__;
    font-weight: 700;
}

QFrame[class="SidebarItem"] {
    background: transparent;
    border: none;
    border-radius: __SIDEBAR_ITEM_RADIUS__;
}

QFrame[class="SidebarItem"][selected="true"] {
    background: __SELECTED_COLOR__;
}

QFrame[class="SidebarItem"][selected="false"]:hover {
    background: __SIDEBAR_ITEM_HOVER__;
}

QLabel#SidebarItemLabel {
    color: __TEXT_COLOR__;
    font-size: __SIDEBAR_ITEM_FONT_SIZE__;
    font-weight: 500;
}

QLabel#SidebarItemIcon,
QLabel#SidebarSectionArrow {
    background: transparent;
}

QScrollArea#SidebarScrollArea QScrollBar:vertical {
    background: transparent;
    border: none;
    width: __SHELF_SCROLLBAR_WIDTH__;
}

QScrollArea#SidebarScrollArea QScrollBar::handle:vertical {
    background: __SHELF_SCROLLBAR_HANDLE__;
    border: none;
    border-radius: __SHELF_SCROLLBAR_RADIUS__;
    min-height: __SHELF_SCROLLBAR_MIN_HEIGHT__;
}

QScrollArea#SidebarScrollArea QScrollBar::handle:vertical:hover {
    background: __SHELF_SCROLLBAR_HANDLE_HOVER__;
}

QScrollArea#SidebarScrollArea QScrollBar::add-line:vertical,
QScrollArea#SidebarScrollArea QScrollBar::sub-line:vertical {
    background: transparent;
    border: none;
    height: 0;
}

QScrollArea#SidebarScrollArea QScrollBar::add-page:vertical,
QScrollArea#SidebarScrollArea QScrollBar::sub-page:vertical {
    background: transparent;
}

/* Shelf toolbar */
QWidget#ShelfContent {
    background: __CONTENT_COLOR__;
    border-top-left-radius: __CONTENT_RADIUS__;
    border-bottom-right-radius: __WINDOW_RADIUS__;
}

QWidget#ShelfContent[sidebarVisible="false"] {
    border-bottom-left-radius: __WINDOW_RADIUS__;
}

QStackedWidget#ShelfStack {
    background: __CONTENT_COLOR__;
    border-bottom-right-radius: __WINDOW_RADIUS__;
}

QWidget#ShelfContent[sidebarVisible="false"] QStackedWidget#ShelfStack {
    border-bottom-left-radius: __WINDOW_RADIUS__;
}

QWidget#SettingsOverlay {
    background: transparent;
    border: none;
}

/* General popup dialog */
QWidget#JoyReadDialogOverlay {
    background: transparent;
    border: none;
}

QFrame[class="JoyReadDialogPanel"] {
    background: __WINDOW_COLOR__;
    border: __DIALOG_PANEL_BORDER_WIDTH__ solid __BUTTON_EDGE__;
    border-radius: __DIALOG_PANEL_RADIUS__;
}

QWidget#JoyReadDialogTitleArea,
QWidget#JoyReadDialogContentArea,
QWidget#JoyReadDialogOptionArea,
QWidget#DialogMessageContent,
QWidget#DialogInputContent,
QWidget#DialogPasswordContent,
QWidget#DialogInputArea {
    background: transparent;
    border: none;
}

QScrollArea#JoyReadDialogContentScrollArea,
QScrollArea#JoyReadDialogContentScrollArea QWidget,
QScrollArea#DialogCollectionInnerScrollArea,
QWidget#DialogCollectionInnerViewport,
QWidget#DialogCollectionRowContent {
    background: transparent;
    border: none;
}

QLabel[class="JoyReadDialogTitle"],
QLabel[class="JoyReadDialogContent"],
QLabel[class="DialogTextButtonText"] {
    color: __TEXT_COLOR__;
    font-size: __DIALOG_FONT_SIZE__;
    font-weight: 400;
}

QFrame[class="DialogTextButton"] {
    background: __WINDOW_COLOR__;
    border: __DIALOG_BUTTON_BORDER_WIDTH__ solid __BUTTON_EDGE__;
    border-radius: __DIALOG_BUTTON_RADIUS__;
}

QFrame[class="DialogTextButton"]:hover {
    background: __SELECTED_COLOR__;
}

QWidget#DialogInputFieldWithHeader {
    background: __CONTENT_COLOR__;
    border: none;
}

QLabel[class="DialogInputHeader"] {
    color: __DIALOG_INPUT_HEADER_COLOR__;
    font-size: __DIALOG_INPUT_HEADER_FONT_SIZE__;
    font-weight: 400;
}

QLineEdit[class="DialogInputField"] {
    background: __WINDOW_COLOR__;
    border: __DIALOG_INPUT_FIELD_BORDER_WIDTH__ solid __BUTTON_INNER_EDGE__;
    border-radius: __DIALOG_INPUT_FIELD_RADIUS__;
    color: __TEXT_COLOR__;
    font-size: __DIALOG_INPUT_HEADER_FONT_SIZE__;
    font-weight: 400;
    padding: __DIALOG_INPUT_FIELD_PADDING__;
}

QLabel#DialogStatePrompt {
    color: __TEXT_COLOR__;
    font-size: __DIALOG_INPUT_STATE_FONT_SIZE__;
    font-weight: 400;
}

QFrame#DialogCollectionScrollPanel {
    background: __WINDOW_COLOR__;
    border: __DIALOG_COLLECTION_SCROLL_BORDER_WIDTH__ solid __BUTTON_INNER_EDGE__;
    border-radius: __DIALOG_COLLECTION_SCROLL_RADIUS__;
}

QFrame[class="DialogCollectionChoice"] {
    background: transparent;
    border: none;
    border-radius: __SIDEBAR_ITEM_RADIUS__;
}

QFrame[class="DialogCollectionChoice"][selected="true"] {
    background: __SELECTED_COLOR__;
}

QFrame[class="DialogCollectionChoice"][selected="false"]:hover {
    background: __SIDEBAR_ITEM_HOVER__;
}

QLabel#DialogCollectionChoiceLabel {
    color: __TEXT_COLOR__;
    font-size: __SIDEBAR_ITEM_FONT_SIZE__;
    font-weight: 500;
}

QLabel#DialogCollectionChoiceIcon {
    background: transparent;
}

QScrollArea#JoyReadDialogContentScrollArea QScrollBar:vertical {
    background: transparent;
    border: none;
    width: __SHELF_SCROLLBAR_WIDTH__;
}

QScrollArea#JoyReadDialogContentScrollArea QScrollBar::handle:vertical {
    background: __SHELF_SCROLLBAR_HANDLE__;
    border: none;
    border-radius: __SHELF_SCROLLBAR_RADIUS__;
    min-height: __SHELF_SCROLLBAR_MIN_HEIGHT__;
}

QScrollArea#JoyReadDialogContentScrollArea QScrollBar::handle:vertical:hover {
    background: __SHELF_SCROLLBAR_HANDLE_HOVER__;
}

QScrollArea#JoyReadDialogContentScrollArea QScrollBar::add-line:vertical,
QScrollArea#JoyReadDialogContentScrollArea QScrollBar::sub-line:vertical {
    background: transparent;
    border: none;
    height: 0;
}

QScrollArea#JoyReadDialogContentScrollArea QScrollBar::add-page:vertical,
QScrollArea#JoyReadDialogContentScrollArea QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollArea#DialogCollectionInnerScrollArea QScrollBar:vertical {
    background: transparent;
    border: none;
    margin: __DIALOG_COLLECTION_SCROLLBAR_MARGIN__ 2px __DIALOG_COLLECTION_SCROLLBAR_MARGIN__ 0;
    width: __SHELF_SCROLLBAR_WIDTH__;
}

QScrollArea#DialogCollectionInnerScrollArea QScrollBar::handle:vertical {
    background: __SHELF_SCROLLBAR_HANDLE__;
    border: none;
    border-radius: __SHELF_SCROLLBAR_RADIUS__;
    min-height: __SHELF_SCROLLBAR_MIN_HEIGHT__;
}

QScrollArea#DialogCollectionInnerScrollArea QScrollBar::handle:vertical:hover {
    background: __SHELF_SCROLLBAR_HANDLE_HOVER__;
}

QScrollArea#DialogCollectionInnerScrollArea QScrollBar::add-line:vertical,
QScrollArea#DialogCollectionInnerScrollArea QScrollBar::sub-line:vertical {
    background: transparent;
    border: none;
    height: 0;
}

QScrollArea#DialogCollectionInnerScrollArea QScrollBar::add-page:vertical,
QScrollArea#DialogCollectionInnerScrollArea QScrollBar::sub-page:vertical {
    background: transparent;
}

QLabel#PageTitle {
    font-size: 28px;
    font-weight: 700;
}

QFrame[class="SearchPanel"] {
    background: transparent;
}

QFrame[class="FigmaDropdownButton"],
QFrame[class="FigmaSearchBar"],
QToolButton[class="FigmaSearchOuterButton"] {
    background: __WINDOW_COLOR__;
    border: 1px solid __BUTTON_EDGE__;
    border-radius: __CONTROL_RADIUS__;
}

QToolButton[class="FigmaSearchOuterButton"]:hover {
    background: __SELECTED_COLOR__;
}

QLabel[class="FigmaDropdownText"] {
    color: __TEXT_COLOR__;
    font-size: __BODY_FONT_SIZE__;
    font-weight: 400;
}

QFrame[class="FigmaDropdownInnerButton"] {
    background: __WINDOW_COLOR__;
    border: 1px solid __BUTTON_INNER_EDGE__;
    border-radius: __CONTROL_RADIUS__;
}

QFrame[class="FigmaDropdownInnerButton"][hovered="true"] {
    background: __SELECTED_COLOR__;
}

QLineEdit#FigmaSearchInput {
    background: transparent;
    border: none;
    color: __TEXT_COLOR__;
    font-size: __BODY_FONT_SIZE__;
    padding: 0;
}

QToolButton[class="FigmaSearchInnerButton"] {
    background: __WINDOW_COLOR__;
    border: 1px solid __BUTTON_INNER_EDGE__;
    border-radius: __SEARCH_INNER_RADIUS__;
    padding: 0;
}

QToolButton[class="FigmaSearchInnerButton"]:hover {
    background: __SELECTED_COLOR__;
}

QFrame#ToolbarSpacer {
    background: #d9d9d9;
    border-radius: 1px;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea[class="ShelfScrollArea"] {
    background: __CONTENT_COLOR__;
    border-bottom-right-radius: __WINDOW_RADIUS__;
}

QWidget#ShelfContent[sidebarVisible="false"] QScrollArea[class="ShelfScrollArea"] {
    border-bottom-left-radius: __WINDOW_RADIUS__;
}

QWidget#ShelfScrollViewport {
    background: __CONTENT_COLOR__;
    border-bottom-right-radius: __WINDOW_RADIUS__;
}

QWidget#ShelfContent[sidebarVisible="false"] QWidget#ShelfScrollViewport {
    border-bottom-left-radius: __WINDOW_RADIUS__;
}

QScrollArea[class="ShelfScrollArea"] QScrollBar:vertical {
    background: transparent;
    border: none;
    margin: 0 0 __SHELF_SCROLLBAR_BOTTOM_MARGIN__ 0;
    width: __SHELF_SCROLLBAR_WIDTH__;
}

QScrollArea[class="ShelfScrollArea"] QScrollBar::handle:vertical {
    background: __SHELF_SCROLLBAR_HANDLE__;
    border: none;
    border-radius: __SHELF_SCROLLBAR_RADIUS__;
    min-height: __SHELF_SCROLLBAR_MIN_HEIGHT__;
}

QScrollArea[class="ShelfScrollArea"] QScrollBar::handle:vertical:hover {
    background: __SHELF_SCROLLBAR_HANDLE_HOVER__;
}

QScrollArea[class="ShelfScrollArea"] QScrollBar[scrollHandleVisible="false"]::handle:vertical {
    background: __SHELF_SCROLLBAR_HANDLE_HIDDEN__;
}

QScrollArea[class="ShelfScrollArea"] QScrollBar::add-line:vertical,
QScrollArea[class="ShelfScrollArea"] QScrollBar::sub-line:vertical {
    background: transparent;
    border: none;
    height: 0;
}

QScrollArea[class="ShelfScrollArea"] QScrollBar::add-page:vertical,
QScrollArea[class="ShelfScrollArea"] QScrollBar::sub-page:vertical {
    background: transparent;
}

/* Book grid and list content */
QWidget#BookGridContent,
QWidget#BookListContent {
    background: transparent;
}

/* Settings page */
QFrame[class="SettingsPanel"] {
    background: __WINDOW_COLOR__;
    border: __SETTINGS_PANEL_BORDER_WIDTH__ solid __BUTTON_EDGE__;
    border-radius: __SETTINGS_PANEL_RADIUS__;
}

QFrame#SettingsSidebar {
    background: __WINDOW_COLOR__;
    border: __SETTINGS_SIDEBAR_BORDER_WIDTH__ solid __BUTTON_INNER_EDGE__;
    border-radius: __SETTINGS_SIDEBAR_RADIUS__;
}

QWidget#SettingsSidebarUpperPart,
QWidget#SettingsSidebarLowerPart,
QScrollArea#SettingsRightScrollArea,
QWidget#SettingsRightViewport,
QWidget#SettingsRightContent,
QWidget#SettingsItemName,
QWidget#SettingsItemOption,
QWidget#SettingsSwitchOption,
QWidget#SettingsAddressOption,
QWidget#SettingsDropdownIndicator {
    background: transparent;
    border: none;
}

QFrame[class="SettingsSidebarItem"] {
    background: transparent;
    border: none;
    border-radius: __SETTINGS_SIDEBAR_ITEM_RADIUS__;
}

QFrame[class="SettingsSidebarItem"][selected="true"] {
    background: __SELECTED_COLOR__;
}

QFrame[class="SettingsSidebarItem"][selected="false"]:hover {
    background: __SIDEBAR_ITEM_HOVER__;
}

QLabel[class="SettingsSidebarItemText"],
QLabel[class="SettingsItemNameText"] {
    color: __TEXT_COLOR__;
    font-size: __SETTINGS_ITEM_FONT_SIZE__;
    font-weight: 500;
}

QFrame[class="SettingsItem"] {
    background: __WINDOW_COLOR__;
    border: none;
    border-radius: __SETTINGS_ITEM_RADIUS__;
}

QFrame[class="SettingsDropdownButton"],
QToolButton[class="SettingsPushButton"] {
    background: __WINDOW_COLOR__;
    border: 1px solid __BUTTON_INNER_EDGE__;
    border-radius: __SETTINGS_ITEM_RADIUS__;
}

QFrame[class="SettingsDropdownButton"]:hover,
QToolButton[class="SettingsPushButton"]:hover {
    background: __SELECTED_COLOR__;
}

QLabel[class="SettingsControlText"],
QToolButton[class="SettingsPushButton"],
QLineEdit[class="SettingsPathField"] {
    color: __TEXT_COLOR__;
    font-size: __SETTINGS_CONTROL_FONT_SIZE__;
    font-weight: 500;
}

QToolButton[class="SettingsPushButton"] {
    padding: 0;
}

QLineEdit[class="SettingsPathField"] {
    background: __WINDOW_COLOR__;
    border: 1px solid __SETTINGS_PATH_EDGE__;
    border-radius: __SETTINGS_ITEM_RADIUS__;
    padding: 0 2px;
}

QFrame[class="SettingsSwitch"] {
    background: __SETTINGS_SWITCH_BACKGROUND__;
    border: 1px solid __BUTTON_INNER_EDGE__;
    border-radius: __SETTINGS_SWITCH_RADIUS__;
}

QFrame[class="SettingsSwitchKnob"] {
    background: __SETTINGS_SWITCH_KNOB__;
    border: none;
    border-radius: __SETTINGS_SWITCH_KNOB_RADIUS__;
}

QScrollArea#SettingsRightScrollArea QScrollBar:vertical {
    background: transparent;
    border: none;
    width: __SHELF_SCROLLBAR_WIDTH__;
}

QScrollArea#SettingsRightScrollArea QScrollBar::handle:vertical {
    background: __SHELF_SCROLLBAR_HANDLE__;
    border: none;
    border-radius: __SHELF_SCROLLBAR_RADIUS__;
    min-height: __SHELF_SCROLLBAR_MIN_HEIGHT__;
}

QScrollArea#SettingsRightScrollArea QScrollBar::handle:vertical:hover {
    background: __SHELF_SCROLLBAR_HANDLE_HOVER__;
}

QScrollArea#SettingsRightScrollArea QScrollBar[scrollHandleVisible="false"]::handle:vertical {
    background: __SHELF_SCROLLBAR_HANDLE_HIDDEN__;
}

QScrollArea#SettingsRightScrollArea QScrollBar::add-line:vertical,
QScrollArea#SettingsRightScrollArea QScrollBar::sub-line:vertical {
    background: transparent;
    border: none;
    height: 0;
}

QScrollArea#SettingsRightScrollArea QScrollBar::add-page:vertical,
QScrollArea#SettingsRightScrollArea QScrollBar::sub-page:vertical {
    background: transparent;
}

QFrame[class="BookCard"] {
    background: __WINDOW_COLOR__;
    border-radius: __BOOK_CARD_RADIUS__;
    border: __BOOK_SELECTION_BORDER_WIDTH__ solid __CARD_SELECTED_TRANSPARENT__;
}

QFrame[class="BookCard"][selected="true"] {
    background: __WINDOW_COLOR__;
    border: __BOOK_SELECTION_BORDER_WIDTH__ solid __CARD_SELECTED__;
}

QFrame[class="BookCard"][missing="true"] {
    background: __WINDOW_COLOR__;
}

QFrame#BookCover {
    border-radius: __BOOK_COVER_RADIUS__;
    background: #f1f1f1;
}

QFrame#BookProgress {
    background: __PROGRESS_BACKGROUND__;
    border: none;
    border-radius: __PROGRESS_RADIUS__;
}

QFrame#BookProgressIndicator {
    background: __PROGRESS_FILL__;
    border: none;
    border-radius: __PROGRESS_RADIUS__;
}

QLabel[class="BookTitle"] {
    font-size: 12px;
    font-weight: 400;
}

QLabel[class="BookMeta"] {
    color: __TEXT_MUTED_COLOR__;
    font-size: 12px;
}

QLabel[class="BookAuthor"] {
    color: __TEXT_MUTED_COLOR__;
    font-size: 12px;
    font-weight: 400;
}

QLabel[class="BookProgressPercent"] {
    color: __TEXT_COLOR__;
    font-size: 12px;
    font-weight: 400;
}

QToolButton[class="CardButton"] {
    background: __WINDOW_COLOR__;
    border: 1px solid __BUTTON_INNER_EDGE__;
    border-radius: __CARD_BUTTON_RADIUS__;
    padding: 0;
}

QToolButton[class="CardButton"]:hover,
QToolButton[class="CardButton"]:checked {
    background: __SELECTED_COLOR__;
    border: 1px solid __BUTTON_INNER_EDGE__;
}

QToolButton[class="CardButton"]:disabled {
    background: __BUTTON_EDGE__;
    border: 1px solid __BUTTON_INNER_EDGE__;
}

/* Figma menu popups */
QWidget#FigmaMenuPopup {
    background: transparent;
}

QWidget#LanguageDropdownMenuPopup {
    background: transparent;
}

QFrame#FigmaMenuPanel {
    background: __MENU_BACKGROUND__;
    border: __MENU_BORDER_WIDTH__ solid __BUTTON_INNER_EDGE__;
    border-radius: __MENU_RADIUS__;
}

QFrame#LanguageDropdownMenuPanel {
    background: __MENU_BACKGROUND__;
    border: __MENU_BORDER_WIDTH__ solid __BUTTON_INNER_EDGE__;
    border-radius: __MENU_RADIUS__;
}

QWidget#FigmaMenuOptionList {
    background: transparent;
}

QWidget#LanguageDropdownMenuIndicator,
QScrollArea#LanguageDropdownMenuScrollArea,
QScrollArea#LanguageDropdownMenuScrollArea QWidget,
QWidget#LanguageDropdownMenuOptionList {
    background: transparent;
    border: none;
}

QScrollArea#LanguageDropdownMenuScrollArea QScrollBar:vertical {
    width: 0;
}

QFrame#FigmaMenuItem {
    background: transparent;
    border: none;
    border-radius: __MENU_ITEM_RADIUS__;
}

QFrame#FigmaMenuItem[selected="true"] {
    background: __MENU_ITEM_HOVER__;
}

QFrame#FigmaMenuItem[menuEnabled="true"]:hover {
    background: __MENU_ITEM_HOVER__;
}

QLabel[class="FigmaMenuItemText"] {
    color: __TEXT_COLOR__;
    font-size: __MENU_FONT_SIZE__;
    font-weight: 400;
}

QLabel[class="FigmaMenuItemText"][destructive="true"] {
    color: __MENU_DESTRUCTIVE__;
}

QFrame[class="BookListRow"] {
    background: __WINDOW_COLOR__;
    border-radius: __BOOK_CARD_RADIUS__;
    border: __BOOK_SELECTION_BORDER_WIDTH__ solid __CARD_SELECTED_TRANSPARENT__;
}

QFrame[class="BookListRow"][selected="true"] {
    background: __WINDOW_COLOR__;
    border: __BOOK_SELECTION_BORDER_WIDTH__ solid __CARD_SELECTED__;
}

/* Floating book detail panel */
QFrame#BookDetailPanel {
    background: __DETAIL_PANEL_BACKGROUND__;
    border: __DETAIL_PANEL_BORDER_WIDTH__ solid __BUTTON_INNER_EDGE__;
    border-radius: __DETAIL_PANEL_RADIUS__;
}

QScrollArea#BookDetailScrollArea,
QWidget#BookDetailViewport,
QWidget#BookDetailContent,
QWidget#BookDetailDescription,
QWidget#BookDetailCoverPanel,
QWidget#BookDetailDescriptionContent,
QWidget#BookDetailMeta,
QWidget#BookDetailNameAuthor,
QWidget#BookDetailAttributes,
QWidget#BookDetailControlPanel,
QWidget#BookDetailControlLeftSide,
QWidget#BookDetailThumbnails {
    background: transparent;
    border: none;
}

QScrollArea#BookDetailScrollArea QScrollBar:vertical {
    background: transparent;
    border: none;
    width: __SHELF_SCROLLBAR_WIDTH__;
}

QScrollArea#BookDetailScrollArea QScrollBar::handle:vertical {
    background: __SHELF_SCROLLBAR_HANDLE__;
    border: none;
    border-radius: __SHELF_SCROLLBAR_RADIUS__;
    min-height: __SHELF_SCROLLBAR_MIN_HEIGHT__;
}

QScrollArea#BookDetailScrollArea QScrollBar::handle:vertical:hover {
    background: __SHELF_SCROLLBAR_HANDLE_HOVER__;
}

QScrollArea#BookDetailScrollArea QScrollBar[scrollHandleVisible="false"]::handle:vertical {
    background: __SHELF_SCROLLBAR_HANDLE_HIDDEN__;
}

QScrollArea#BookDetailScrollArea QScrollBar::add-line:vertical,
QScrollArea#BookDetailScrollArea QScrollBar::sub-line:vertical {
    background: transparent;
    border: none;
    height: 0;
}

QScrollArea#BookDetailScrollArea QScrollBar::add-page:vertical,
QScrollArea#BookDetailScrollArea QScrollBar::sub-page:vertical {
    background: transparent;
}

QLabel[class="BookDetailTitle"] {
    color: __TEXT_COLOR__;
    font-size: __DETAIL_TITLE_FONT_SIZE__;
    font-weight: 400;
}

QLabel[class="BookDetailAuthor"],
QLabel[class="BookDetailPillText"] {
    color: __TEXT_COLOR__;
    font-size: __DETAIL_META_FONT_SIZE__;
    font-weight: 400;
}

QLineEdit[class="BookDetailInlineEdit"] {
    background: __WINDOW_COLOR__;
    border: 1px solid __BUTTON_EDGE__;
    border-radius: 4px;
    color: __TEXT_COLOR__;
    padding: 1px 3px;
}

QFrame[class="BookDetailPill"] {
    background: transparent;
    border: 1px solid __BUTTON_EDGE__;
    border-radius: __DETAIL_ATTRIBUTE_RADIUS__;
}

QLabel[class="BookDetailProgressPercent"] {
    color: __TEXT_COLOR__;
    font-size: 12px;
    font-weight: 400;
}

QFrame[class="DetailReadButton"],
QToolButton[class="DetailIconButton"] {
    background: __WINDOW_COLOR__;
    border: __DETAIL_BUTTON_BORDER_WIDTH__ solid __BUTTON_EDGE__;
    border-radius: __DETAIL_BUTTON_RADIUS__;
}

QToolButton[class="DetailIconButton"] {
    padding: __DETAIL_BUTTON_LAYOUT_MARGIN__;
}

QLabel[class="DetailReadButtonText"] {
    color: __TEXT_COLOR__;
    font-size: __DETAIL_READ_FONT_SIZE__;
    font-weight: 400;
}

QFrame[class="DetailReadButton"]:hover,
QToolButton[class="DetailIconButton"]:hover {
    background: __SELECTED_COLOR__;
}

/* Empty/loading/error placeholders */
QWidget[class="StateView"] {
    background: transparent;
}

QLabel[class="StateTitle"] {
    font-size: 20px;
    font-weight: 700;
}

QLabel[class="StateBody"] {
    color: #6d6d6d;
    font-size: 14px;
}
